{
  "name": "personal-todo-manager",
  "version": "3.1.0",
  "private": true,
  "description": "ZAWISH Workboard: personal task boards for the team, on Cloudflare Workers + D1",
  "scripts": {
    "dev": "wrangler dev",
    "db:local": "wrangler d1 migrations apply zawish-workboard --local",
    "db:remote": "wrangler d1 migrations apply zawish-workboard --remote",
    "test": "node --test \"test/*.test.js\" \"test/*.test.mjs\"",
    "deploy": "wrangler deploy",
    "admin": "node scripts/admin.mjs"
  },
  "keywords": [
    "todo",
    "task-manager",
    "pwa",
    "cross-device"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "wrangler": "^4.152.0"
  }
}
